      "css": ".ds-tabs{display:flex;gap:12px}.ds-tab{font-family:\"Segoe UI Variable\",\"Segoe UI\",sans-serif;font-size:14px;color:#ECF5F2; background:transparent;color:#AEC3BE;padding:12px 18px;border:1px solid #2C4149;border-radius:8px;cursor:pointer}.ds-tab[aria-current]{background:#183D36;color:#54DEC1}.ds-tab:hover{background:#1D2D34}.ds-tab:focus-visible{outline:none;border-color:#54DEC1}.ds-tab:active{background:#172329}",
