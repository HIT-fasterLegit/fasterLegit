  "narrative": {
    "donts": [
      "Don't add promotional references to the previous identity in user-facing surfaces.",
      "Don't remove mandatory copyright, license or legal attribution notices.",
      "Don't invent health scores, performance measurements or speedup claims.",
      "Don't replace the horizontal workspace with the old navigation rail."
    ],
    "overview": "VELORA makes local Windows maintenance feel orderly and deliberate. Graphite surfaces, mint emphasis and familiar native controls give real machine information priority. Actions remain close to their scope, with risk and recovery information visible before changes are applied.\n\nThe composition is a workspace: horizontal navigation, broad reading rows, compact supporting metadata and a restrained identity. The light theme uses the same hierarchy with pale green neutrals and deep teal emphasis. The owner delegated the design and approved the VELORA identity and teal direction.",
    "rules": [
      {
        "section": "colors",
        "name": "The Semantic Accent Rule",
        "body": "Use teal for selection and intentional actions; keep warning, danger and success states tied to their existing semantic resources and text labels."
      },
      {
        "section": "layout",
        "name": "The Scope Rule",
        "body": "Keep batch actions outside individual rows, next to the selection summary for the list they affect."
      }
    ],
    "dos": [
      "Do bind surfaces and accent foregrounds through paired theme resources.",
      "Do preserve localized wrapping, keyboard access and native control states.",
      "Do show real system data, scoped actions, risk and supported recovery.",
      "Do reuse the approved VELORA mark and native Fluent symbols."
    ],
    "northStar": "The Quiet Control Room",
    "keyCharacteristics": [
      "Native WPF interaction and Fluent symbols.",
      "Restrained teal emphasis over layered neutral surfaces.",
      "Clear task hierarchy and readable localized content.",
      "Explicit selection, review and action areas."
    ]
  }
}
