<Page x:Class="fasterLegit.UI.Pages.AdvisorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ext="clr-namespace:fasterLegit.Common.Extensions"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Style="{StaticResource PageRootStyle}">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Style="{StaticResource PageHeaderStyle}">
            <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc AI.Title}" />
            <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc AI.Description}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander Header="{ext:Loc AI.Settings.Title}" Margin="0,0,0,20">
                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel IsEnabled="{Binding ViewModel.IsIdle}">
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Margin="0,0,16,0">
                                    <ui:TextBlock Text="{ext:Loc AI.Settings.Provider}" Style="{StaticResource SectionHeaderStyle}" />
                                    <ComboBox SelectedIndex="{Binding ViewModel.ProviderIndex}" AutomationProperties.Name="{ext:Loc AI.Settings.Provider}">
                                        <ComboBoxItem Content="{ext:Loc AI.Settings.Local}" />
                                        <ComboBoxItem Content="{ext:Loc AI.Settings.Api}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="{ext:Loc AI.Settings.Sample}" Style="{StaticResource SectionHeaderStyle}" />
                                    <ui:NumberBox Minimum="5" Maximum="60" Value="{Binding ViewModel.SampleSeconds, Mode=TwoWay}" AutomationProperties.Name="{ext:Loc AI.Settings.Sample}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,16,0">
                                    <ui:TextBlock Text="{ext:Loc AI.Settings.LocalEndpoint}" />
                                    <ui:TextBox Text="{Binding ViewModel.LocalEndpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ext:Loc AI.Settings.LocalEndpoint}" />
                                    <ui:TextBlock Margin="0,10,0,0" Text="{ext:Loc AI.Settings.LocalModel}" />
                                    <ui:TextBox Text="{Binding ViewModel.LocalModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ext:Loc AI.Settings.LocalModel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="{ext:Loc AI.Settings.ApiEndpoint}" />
                                    <ui:TextBox Text="{Binding ViewModel.ApiEndpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ext:Loc AI.Settings.ApiEndpoint}" />
                                    <ui:TextBlock Margin="0,10,0,0" Text="{ext:Loc AI.Settings.ApiModel}" />
                                    <ui:TextBox Text="{Binding ViewModel.ApiModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ext:Loc AI.Settings.ApiModel}" />
                                </StackPanel>
                            </Grid>
                            <ui:TextBlock Margin="0,12,0,4" Text="{ext:Loc AI.Settings.Key}" />
                            <PasswordBox x:Name="ApiKeyInput" PasswordChanged="OnApiKeyChanged" MaxLength="500" AutomationProperties.Name="{ext:Loc AI.Settings.Key}" />
                            <ui:TextBlock Margin="0,6,0,8" Style="{StaticResource CaptionTextStyle}" Text="{ext:Loc AI.Settings.KeyHint}" />
                            <WrapPanel>
                                <ui:Button Click="OnSaveSettings" Content="{ext:Loc AI.Settings.Save}" Appearance="Primary" Margin="0,0,8,8" />
                                <ui:Button Command="{Binding ViewModel.TestConnectionCommand}" Content="{ext:Loc AI.Settings.Test}" Margin="0,0,8,8" />
                                <ui:Button Command="{Binding ViewModel.ClearKeyCommand}" Content="{ext:Loc AI.Settings.ClearKey}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{ext:Loc AI.Settings.LocalHint}" />
                        </StackPanel>
                    </Border>
                </Expander>
                <Grid ColumnDefinitions="280,*">
                    <StackPanel Margin="0,0,20,0">
                        <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{ext:Loc AI.Mode.Title}" />
                        <ComboBox SelectedIndex="{Binding ViewModel.ModeIndex}" IsEnabled="{Binding ViewModel.IsIdle}" AutomationProperties.Name="{ext:Loc AI.Mode.Title}">
                            <ComboBoxItem Content="{ext:Loc AI.Mode.Diagnose}" />
                            <ComboBoxItem Content="{ext:Loc AI.Mode.Applications}" />
                            <ComboBoxItem Content="{ext:Loc AI.Mode.Maintenance}" />
                        </ComboBox>
                        <ui:TextBlock Margin="0,16,0,6" Style="{StaticResource SectionHeaderStyle}" Text="{ext:Loc AI.Question}" />
                        <ui:TextBox Text="{Binding ViewModel.Question, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="126" MaxLength="4000" IsEnabled="{Binding ViewModel.IsIdle}" PlaceholderText="{ext:Loc AI.Question.Hint}" AutomationProperties.Name="{ext:Loc AI.Question}" />
                        <ui:TextBlock Margin="0,14,0,6" Text="{ext:Loc AI.Goal}" />
                        <ui:TextBox Text="{Binding ViewModel.Goal, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="70" MaxLength="2000" IsEnabled="{Binding ViewModel.IsIdle}" PlaceholderText="{ext:Loc AI.Goal.Hint}" AutomationProperties.Name="{ext:Loc AI.Goal}" />
                        <CheckBox IsChecked="{Binding ViewModel.AllowRemoteData}" IsEnabled="{Binding ViewModel.IsIdle}" Margin="0,14,0,12">
                            <TextBlock Text="{ext:Loc AI.Consent}" TextWrapping="Wrap" />
                        </CheckBox>
                        <WrapPanel>
                            <ui:Button Command="{Binding ViewModel.AnalyzeCommand}" Content="{ext:Loc AI.Analyze}" Appearance="Primary" Margin="0,0,8,8" />
                            <ui:Button Command="{Binding ViewModel.CancelCommand}" Content="{ext:Loc Common.Cancel}" IsEnabled="{Binding ViewModel.IsBusy}" Margin="0,0,8,8" />
                            <ui:Button Command="{Binding ViewModel.ClearConversationCommand}" Content="{ext:Loc AI.ClearConversation}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <ui:TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionTextStyle}" Text="{ext:Loc AI.PrivacyHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ui:ProgressRing Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8" IsIndeterminate="True" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock Text="{Binding ViewModel.Status}" Foreground="{DynamicResource BrandAccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                        <ui:TextBlock Text="{Binding ViewModel.Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive" />
                        <Border Style="{StaticResource BrandIntroStyle}" Visibility="{Binding ViewModel.HasReport, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ui:TextBlock Text="{ext:Loc AI.Empty.Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ui:TextBlock Text="{ext:Loc AI.Empty.Description}" Style="{StaticResource PageDescriptionStyle}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding ViewModel.HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="{ext:Loc AI.Report.Limits}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" />
                            <ui:TextBlock Text="{Binding ViewModel.Summary}" FontSize="17" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding ViewModel.Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ui:TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            <ItemsControl ItemsSource="{Binding EvidenceIds}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><ui:TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,10,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="{ext:Loc AI.Evidence.Title}" Margin="0,0,0,18">
                                <ItemsControl ItemsSource="{Binding ViewModel.Evidence}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,12,0,8">
                                            <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ui:TextBlock Text="{Binding Id}" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,6" />
                                            <ui:TextBlock Text="{Binding Source}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <ui:TextBlock Text="{ext:Loc AI.Actions.Title}" Style="{StaticResource SectionHeaderStyle}" />
                            <ui:TextBlock Text="{ext:Loc AI.Actions.Hint}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding ViewModel.Actions}" IsEnabled="{Binding ViewModel.IsIdle}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                                        <StackPanel>
                                            <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ui:TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,12">
                                <ui:Button Command="{Binding ViewModel.ExecuteActionsCommand}" Content="{ext:Loc AI.Actions.Execute}" Appearance="Primary" Margin="0,0,8,8" />
                                <ui:Button Command="{Binding ViewModel.RecheckCommand}" Content="{ext:Loc AI.Recheck}" Margin="0,0,8,8" />
                                <ui:Button Command="{Binding ViewModel.SaveReportCommand}" Content="{ext:Loc AI.SaveReport}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding ViewModel.ExecutionMessages}"><ItemsControl.ItemTemplate><DataTemplate><ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ui:TextBlock Text="{Binding ViewModel.ComparisonText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ui:TextBlock Text="{Binding ViewModel.SavedReportPath}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
