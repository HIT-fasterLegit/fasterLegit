<UserControl
    x:Class="fasterLegit.UI.Dialogs.LegalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:fasterLegit.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:fasterLegit.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="640"
    d:DesignWidth="520"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ThemeToGitHubIconConverter x:Key="ThemeToGitHubIconConverter" />
        <converters:ThemeToIndexConverter x:Key="ThemeToIndexConverter" />
    </UserControl.Resources>
    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Greeting, friendly, compact  -->
        <StackPanel Grid.Row="0">
            <ui:TextBlock
                FontTypography="Subtitle"
                Text="{ext:Loc LegalDialog.Intro.Title}"
                TextWrapping="Wrap" />
            <ui:TextBlock
                Margin="0,6,0,0"
                FontTypography="Body"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{ext:Loc LegalDialog.Intro.Description}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Preferences: Theme, reuse the Settings card  -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <ui:TextBlock
                Margin="0,0,0,8"
                FontTypography="BodyStrong"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{ext:Loc LegalDialog.Preferences.Header}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Color24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock
                            FontTypography="BodyStrong"
                            Text="{ext:Loc LegalDialog.Theme.Title}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{ext:Loc LegalDialog.Theme.Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox SelectedIndex="{Binding CurrentApplicationTheme, Converter={StaticResource ThemeToIndexConverter}, Mode=TwoWay}">
                    <ComboBoxItem Content="{ext:Loc Settings.Appearance.ThemeSelector.Light}" />
                    <ComboBoxItem Content="{ext:Loc Settings.Appearance.ThemeSelector.Dark}" />
                    <ComboBoxItem Content="{ext:Loc Settings.Appearance.ThemeSelector.HighContrast}" />
                </ComboBox>
            </ui:CardControl>
        </StackPanel>

        <!--  Legal links, compact toolbar style  -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Style="{StaticResource ToolbarSurfaceStyle}">
            <WrapPanel Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    VerticalContentAlignment="Center"
                    Content="{ext:Loc LegalDialog.Link.TermsOfService}"
                    FontWeight="SemiBold"
                    Icon="{ui:SymbolIcon DocumentText24,
                                         FontSize=18,
                                         Filled=True}"
                    Command="{Binding OpenDocumentCommand}" CommandParameter="TERMS.md" />
                <ui:Button
                    Margin="0,0,8,0"
                    Content="{ext:Loc LegalDialog.Link.PrivacyPolicy}"
                    FontWeight="SemiBold"
                    Icon="{ui:SymbolIcon ShieldLock24,
                                         FontSize=18,
                                         Filled=True}"
                    Command="{Binding OpenDocumentCommand}" CommandParameter="PRIVACY.md" />
                <ui:Button
                    Content="{ext:Loc LegalDialog.Link.Disclaimer}"
                    FontWeight="SemiBold"
                    Icon="{ui:SymbolIcon Warning24,
                                         FontSize=18,
                                         Filled=True}"
                    Command="{Binding OpenDocumentCommand}" CommandParameter="DISCLAIMER.md" />
            </WrapPanel>
        </Border>

        <ui:InfoBar
            Title="{ext:Loc LegalDialog.Warning.Title}"
            Grid.Row="4"
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="True"
            Message="{ext:Loc LegalDialog.Warning.Message}"
            Severity="Warning" />
    </Grid>
</UserControl>
