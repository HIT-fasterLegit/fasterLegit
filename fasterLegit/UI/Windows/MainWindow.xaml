<ui:FluentWindow
    x:Class="fasterLegit.UI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="clr-namespace:fasterLegit.Services.Configuration"
    xmlns:controls="clr-namespace:fasterLegit.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:fasterLegit.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:fasterLegit.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:fasterLegit.UI.ViewModels.Windows"
    xmlns:windows="clr-namespace:fasterLegit.UI.Windows"
    Title="{extensions:Loc Brand.Name}"
    Width="1360"
    Height="860"
    MinWidth="900"
    MinHeight="620"
    d:DataContext="{d:DesignInstance viewmodels:MainWindowViewModel}"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    ExtendsContentIntoTitleBar="True"
    SnapsToDevicePixels="True"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    FontFamily="Segoe UI Variable, Segoe UI"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}" FlowDirection="{Binding Direction, Source={x:Static config:Loc.Instance}}">
        <ui:NavigationView
            x:Name="RootNavigation"
            Margin="0,44,0,0"
            Padding="0"
            FrameMargin="0"
            IsFooterSeparatorVisible="False"
            IsPaneToggleVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTopSeparatorVisible="False"
            PaneDisplayMode="Top"
            OpenPaneLength="236"
            Style="{StaticResource ScrollableTopNavigationViewStyle}"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}">
            <ui:NavigationView.MenuItems>
                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Dashboard}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Optimize}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Flash24}"
                    TargetPageType="{x:Type pages:OptimizePage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Bloatware}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Delete24}"
                    TargetPageType="{x:Type pages:BloatwarePage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.StartupManager}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Power24}"
                    TargetPageType="{x:Type pages:StartupManagerPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.DiskCleanup}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon HardDrive20}"
                    TargetPageType="{x:Type pages:DiskCleanupPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Settings}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar x:Name="TitleBar" Height="44" VerticalAlignment="Top">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        FontSize="15"
                        Foreground="{DynamicResource TextFillColorDisabledBrush}"
                        Symbol="ShieldCheckmark24" />
                    <ui:ImageIcon
                        Height="28"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Source="pack://application:,,,/Resources/Images/VeloraMark.png" />
                    <ui:TextBlock
                        x:Name="AppTitleText"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="{extensions:Loc Brand.Name}" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{DynamicResource TextFillColorDisabledBrush}"
                        Text="{Binding Version, Mode=OneWay}" />
                </StackPanel>
            </ui:TitleBar.Header>

        </ui:TitleBar>

        <ui:ContentDialogHost x:Name="RootContentDialogPresenter" />
    </Grid>
</ui:FluentWindow>
